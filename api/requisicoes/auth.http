@urlBase = http://localhost:4000

### login
# @name postLogin
POST {{urlBase}}/login
Content-Type: application/json

{
  "email": "gerlucio@example.com",
  "senha": "123456"
}

### cadastrar usuário
POST {{urlBase}}/usuarios
Content-Type: application/json

{
  "nome": "Zé Bode",
  "email": "zebode@example.com",
  "senha": "123456"
}

### token
@token = {{postLogin.response.body.token}}

### rota protegida
GET {{urlBase}}/filmes
Authorization: Bearer {{token}}

